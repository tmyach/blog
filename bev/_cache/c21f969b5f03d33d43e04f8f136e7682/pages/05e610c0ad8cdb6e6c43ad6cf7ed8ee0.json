{"config": {"title": null, "format": "html", "content_type": "html", "segments": ["content"]}, "content": {"content": {"c": "<div id=\"blog-post-source\">\n    <ul class=\"blog-post-source\">\n    {% for post in blog.posts %}\n        <li class=\"blog-post\" data-timestamp=\"{{ post.timestamp }}\">\n            <time datetime=\"{{ post.timestamp|date('%Y-%m-%d') }}\">{{ post.date }}</time>\n            <a href=\"{{ post.url }}\">{{ post.title }}</a>{% if post.hint %}: {{ post.hint }}{% endif %}\n        </li>\n    {% endfor %}\n    </ul>\n</div>\n\n<div id=\"blog-post-groups\"></div>\n\n<script>\n    (() => {\n        const source = document.getElementById(\"blog-post-source\");\n        const groups = document.getElementById(\"blog-post-groups\");\n        const posts = [...source.querySelectorAll(\".blog-post\")];\n        const cutoff = new Date();\n        cutoff.setUTCFullYear(cutoff.getUTCFullYear() - 1);\n\n        const sections = [\n            { title: \"Recent Posts\", cutoff: true },\n            { title: \"Archive\", cutoff: false }\n        ];\n\n        for (const sectionData of sections) {\n            const sectionPosts = posts.filter(post =>\n                (Number(post.dataset.timestamp) * 1000 >= cutoff.getTime()) === sectionData.cutoff\n            );\n            const section = document.createElement(\"section\");\n            section.className = \"blog-section\";\n\n            const heading = document.createElement(\"h2\");\n            heading.className = \"blog-section-title\";\n            heading.textContent = sectionData.title;\n            section.append(heading);\n\n            const months = new Map();\n            for (const post of sectionPosts) {\n                const date = new Date(Number(post.dataset.timestamp) * 1000);\n                const key = `${date.getUTCFullYear()}-${date.getUTCMonth()}`;\n                let month = months.get(key);\n                if (!month) {\n                    month = document.createElement(\"section\");\n                    month.className = \"blog-month\";\n\n                    const monthHeading = document.createElement(\"h3\");\n                    monthHeading.className = \"blog-month-title\";\n                    monthHeading.textContent = new Intl.DateTimeFormat(\"en\", {\n                        month: \"long\",\n                        year: \"numeric\",\n                        timeZone: \"UTC\"\n                    }).format(date);\n                    month.append(monthHeading);\n\n                    const list = document.createElement(\"ul\");\n                    list.className = \"blog-month-posts\";\n                    month.append(list);\n                    section.append(month);\n                    months.set(key, list);\n                }\n                months.get(key).append(post);\n            }\n\n            if (sectionPosts.length === 0) {\n                const emptyMessage = document.createElement(\"p\");\n                emptyMessage.textContent = sectionData.cutoff ? \"No recent posts.\" : \"No archived posts yet.\";\n                section.append(emptyMessage);\n            }\n            groups.append(section);\n        }\n\n        source.remove();\n    })();\n</script>\n\n{% if blog.tags %}\n<nav class=\"mb-bank\" aria-label=\"Browse posts by tag\">\n    <span class=\"mb-label\">Tags</span>\n    {% for t in blog.tags %}\n    <a class=\"mb-tag\" href=\"{{ pctagurl(t.term) }}\">{{ t.term }}</a>\n    {% endfor %}\n</nav>\n{% endif %}", "f": null, "o": 30, "l": 6}}}